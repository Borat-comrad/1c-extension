{
  "manifest_version": 3,
  "name": "ServiceLine 1C Price History",
  "version": "0.1.0",
  "description": "MVP: получение истории цен из 1С по коду производителя.",
  "action": {
    "default_title": "История цен 1С",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://192.168.11.240:8282/*",
    "https://mail.google.com/*"
  ]
}

