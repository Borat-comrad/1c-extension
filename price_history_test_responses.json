{
  "filePurpose": "Набор тестовых ответов 1С для проверки красивого отображения в Chrome Extension popup gmail-1c-extension.",
  "version": "1.0",
  "usageForCodex": [
    "Положить файл в проект, например: tests/fixtures/price_history_test_responses.json",
    "Использовать каждый объект testCases[i].response как имитацию ответа 1С.",
    "Для testCases с rawResponseText проверять обработку невалидного JSON.",
    "Сравнить UI с testCases[i].expected и подготовить детальный отчёт по каждому кейсу."
  ],
  "testCases": [
    {
      "id": "T01_single_price_minimal_real",
      "title": "Минимальный реальный ответ: одна цена, остальные поля пустые",
      "purpose": "Базовый сценарий из 1С. Проверить, что нет сырого JSON, последняя цена и средняя цена равны одной цене.",
      "inputCode": "0-905-21-102-2",
      "response": {
        "ИсторияПоставок": null,
        "ИсторияЦен": [
          {
            "Контрагент": "BBM SERVICE SRL.",
            "Цена": 3357.88,
            "Валюта": "EUR"
          }
        ],
        "ДанынеРекламаций": null,
        "СписокСапКодов": null,
        "КодКонечногоПроизводителя": "",
        "РасширенноеНаименование": "",
        "Группа": ""
      },
      "expected": {
        "lastPrice": "3357.88 EUR",
        "averagePrice": "3357.88 EUR",
        "pricesCount": 1,
        "emptyFieldsShouldShow": "нет данных"
      }
    },
    {
      "id": "T02_multiple_prices_same_currency",
      "title": "Несколько цен в одной валюте",
      "purpose": "Проверить расчёт средней арифметической, последнюю цену как последний элемент массива и список всех цен.",
      "inputCode": "ABC-1000",
      "response": {
        "ИсторияПоставок": null,
        "ИсторияЦен": [
          {
            "Дата": "2024-11-15",
            "Контрагент": "ALFA PARTS GmbH",
            "Цена": 120.1,
            "Валюта": "EUR"
          },
          {
            "Дата": "2025-03-02",
            "Контрагент": "BETA SERVICE SRL.",
            "Цена": 130.5,
            "Валюта": "EUR"
          },
          {
            "Дата": "2025-09-21",
            "Контрагент": "GAMMA SUPPLY LTD",
            "Цена": 150.4,
            "Валюта": "EUR"
          }
        ],
        "ДанынеРекламаций": null,
        "СписокСапКодов": [],
        "КодКонечногоПроизводителя": "END-ABC-1000",
        "РасширенноеНаименование": "Комплект направляющих для узла розлива",
        "Группа": "Механические комплектующие"
      },
      "expected": {
        "lastPrice": "150.40 EUR",
        "averagePrice": "133.67 EUR",
        "pricesCount": 3,
        "averageCalculation": "(120.10 + 130.50 + 150.40) / 3"
      }
    },
    {
      "id": "T03_multiple_prices_different_currencies",
      "title": "Несколько цен в разных валютах",
      "purpose": "Проверить, что средняя цена считается по числам, но валюта помечается как 'разные валюты'.",
      "inputCode": "MIX-CURRENCY-01",
      "response": {
        "ИсторияПоставок": null,
        "ИсторияЦен": [
          {
            "Контрагент": "EU PARTNER",
            "Цена": 100,
            "Валюта": "EUR"
          },
          {
            "Контрагент": "US PARTNER",
            "Цена": 110,
            "Валюта": "USD"
          },
          {
            "Контрагент": "LOCAL SUPPLIER",
            "Цена": 9000,
            "Валюта": "RUB"
          }
        ],
        "ДанынеРекламаций": null,
        "СписокСапКодов": null,
        "КодКонечногоПроизводителя": "",
        "РасширенноеНаименование": "Тест разных валют",
        "Группа": "Тестовые данные"
      },
      "expected": {
        "lastPrice": "9000 RUB",
        "averagePrice": "3070.00 разные валюты",
        "pricesCount": 3,
        "note": "Конвертацию валют не делать, только явно пометить разные валюты."
      }
    },
    {
