      "expected": {
        "lastPrice": "нет данных",
        "averagePrice": "нет данных",
        "pricesCount": 0
      }
    },
    {
      "id": "T05_empty_price_array",
      "title": "История цен — пустой массив",
      "purpose": "Проверить, что пустой массив не отображается как JSON и не ломает расчёты.",
      "inputCode": "EMPTY-PRICE-ARRAY",
      "response": {
        "ИсторияПоставок": [],
        "ИсторияЦен": [],
        "ДанынеРекламаций": [],
        "СписокСапКодов": [],
        "КодКонечногоПроизводителя": "",
        "РасширенноеНаименование": "",
        "Группа": "Пустые массивы"
      },
      "expected": {
        "lastPrice": "нет данных",
        "averagePrice": "нет данных",
        "pricesCount": 0,
        "emptyArraysShouldShow": "нет данных"
      }
